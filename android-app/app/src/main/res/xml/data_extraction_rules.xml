<?xml version="1.0" encoding="utf-8"?>
<!--
  The dashboard has nothing worth restoring onto a new device: the watchlist is a preference
  the user re-enters once and quotes are re-fetched. Cloud backup and device transfer are
  therefore both switched off.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>